{
  "expo": {
    "name": "react-native-expo-ADS",
    "slug": "react-native-expo-ADS",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "react-native-expo",
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router"
    ]
  },
  "ios": {
    "supportsTablet": true
  },
  "android": {
    "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "backgroundColor": "#ffffff"
    },
    "edgeToEdgeEnabled": true
  },
  "web": {
    "favicon": "./assets/favicon.png",
    "bundler": "metro"
  },
  "plugins": [
    "expo-router"
  ]
}
